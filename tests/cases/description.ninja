builddir = build/bob
build build/bob/always: phony

rule echo-bob-1
  command = echo hi > $out
  description = ECHO $out

build build/hi: echo-bob-1
build $root/tests/cases/description.bob build/bob/configs.json: phony
rule configure-bob-2
